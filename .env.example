# The process reads PORT; use an unprivileged port.
PORT=8080
# Browser-restricted key, supplied at runtime. Keep actual values in private configuration.
GOOGLE_MAPS_API_KEY=
# Optional map ID for advanced markers; Google's public demo map is the default.
GOOGLE_MAPS_MAP_ID=
# Demo session duration in whole minutes (1–120); browser countdown and expiry.
SESSION_LIMIT_MINUTES=120
